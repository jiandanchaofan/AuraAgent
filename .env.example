# Copy this file to .env and fill in your key(s).

# Which LLMProvider to use: "anthropic" or "openai".
# "openai" also covers any OpenAI-compatible endpoint (DeepSeek, etc.) —
# just set OPENAI_BASE_URL accordingly.
AURA_LLM_PROVIDER=anthropic

# --- Anthropic (used when AURA_LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenAI-compatible (used when AURA_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset to hit OpenAI's own API.
# For DeepSeek, uncomment the next line and set AURA_MODEL_ID=deepseek-chat below.
# OPENAI_BASE_URL=https://api.deepseek.com

# Optional overrides — defaults shown.
AURA_MODEL_ID=claude-opus-5
AURA_MAX_TURNS=15
AURA_LOG_LEVEL=INFO

# Where the general file-management tools (list_directory/read_file/
# write_file/delete_file/move_file/copy_file/get_file_info/search_files)
# and download_file are sandboxed to — path traversal outside this folder
# is always rejected, but WHICH folder that is can be pointed at your real
# working directory instead of the repo-local default.
# AURA_WORKSPACE_ROOT=C:\Users\you\Documents\AuraWorkspace
# AURA_DOWNLOAD_MAX_BYTES=50000000
