# Copy this file to .env and fill in your key(s).

# Which LLMProvider to use: "anthropic" or "openai".
# "openai" also covers any OpenAI-compatible endpoint (DeepSeek, etc.) —
# just set OPENAI_BASE_URL accordingly.
AURA_LLM_PROVIDER=anthropic

# --- Anthropic (used when AURA_LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenAI-compatible (used when AURA_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL unset to hit OpenAI's own API.
# For DeepSeek, uncomment the next line and set AURA_MODEL_ID=deepseek-chat below.
# OPENAI_BASE_URL=https://api.deepseek.com

# Optional overrides — defaults shown.
AURA_MODEL_ID=claude-opus-5
AURA_MAX_TURNS=15
AURA_LOG_LEVEL=INFO
# Max tokens the model can generate in a single reply. If a large tool
# call (e.g. create_pptx for a many-slide deck) gets cut off mid-JSON with
# an error mentioning "max_tokens" or "cut off", raise this.
AURA_LLM_MAX_OUTPUT_TOKENS=8192

# Where the general file-management tools (list_directory/read_file/
# write_file/delete_file/move_file/copy_file/get_file_info/search_files)
# and download_file are sandboxed to — path traversal outside this folder
# is always rejected, but WHICH folder that is can be pointed at your real
# working directory instead of the repo-local default.
# AURA_WORKSPACE_ROOT=C:\Users\you\Documents\AuraWorkspace
# AURA_DOWNLOAD_MAX_BYTES=50000000

# Calendar backend: "local" (default, a JSON file in sandbox/calendar/) or
# "google" (a real Google Calendar). Don't set this to "google" by hand --
# run /calendar connect instead, which sets it automatically once OAuth
# succeeds (see README.md for the one-time Google Cloud Console setup it needs first).
# AURA_CALENDAR_BACKEND=google

# Tasks backend: "local" (default, a JSON file in sandbox/tasks/) or
# "google" (your real Google Tasks account, into a dedicated "AuraAgent"
# list AuraAgent finds-or-creates itself). Don't set this to "google" by
# hand -- run /tasks connect instead, which sets this AND
# AURA_GOOGLE_TASKS_LIST_ID automatically once OAuth succeeds (reuses the
# same Google OAuth client secret as Calendar, but its own separate token
# -- enable the "Google Tasks API" for that same Cloud Console project first).
# AURA_TASKS_BACKEND=google
# AURA_GOOGLE_TASKS_LIST_ID=

# Which subdirectory under AURA_NOTES_SANDBOX_ROOT (or a real Obsidian
# vault, once /notes set repoints it) holds daily note files -- quick
# notes synced from a phone (N14) get appended there as Thino-style
# bullets under each day's "Today's Thino" heading. Defaults to "Daily
# Notes", matching Obsidian's own Thino plugin convention.
# AURA_QUICK_NOTES_SUBDIR=Daily Notes

# Off by default -- a purely local setup doesn't need this. Set to 1 only
# once this process will be reachable by something other than you sitting
# at this machine (e.g. behind a Cloudflare Tunnel for an Auralis phone
# client). Register at least one device token FIRST with /device register
# <name> (while this is still unset/0), otherwise you lock yourself out of
# every REST/WebSocket call, including the one that would register one.
# AURA_REQUIRE_AUTH=1

# --- Telegram bot frontend (telegram_bot.py) ---
# Create a bot via @BotFather on Telegram (free, official Bot API -- no
# reverse-engineered client, no ToS risk), paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat_id -- the bot ONLY responds to this one chat and
# silently ignores everyone else (this is a personal single-user
# assistant, not a public bot). Leave unset on first run: the bot's only
# behavior will be replying to any message with "your chat_id is <N> --
# set AURA_TELEGRAM_ALLOWED_CHAT_ID=<N> here and restart."
# AURA_TELEGRAM_ALLOWED_CHAT_ID=123456789
