{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AuraAgent: main.py (REPL)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "AuraAgent: debug test_react_engine.py (no network, FakeLLMProvider)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_react_engine.py", "-v", "-s"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "AuraAgent: debug current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "-s"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}
